inger.com/article/10.1007/s00466-006-0054-9"}],"suggested_comparisons":[],"contexts":[{"text":"在六维随机输入空间中选取代表性联合样本。","language":"zh","source_id":"P008","paper_slug":"2017-earthquake-track-stochastic-analysis","title":"地震与轨道随机不平顺作用下车辆—轨道耦合系统随机分析模型","kind":"paper_usage"},{"text":"在多维单位超立方体内布置代表点，以组合不同类型不平顺。","language":"zh","source_id":"P016","paper_slug":"2018-probabilistic-assessment-of-railway-vehicle-curved-track-systems-considering-track-random-irregulari","title":"考虑轨道随机不平顺的铁路车辆—曲线轨道系统概率评估","kind":"paper_usage"},{"text":"构造四类不平顺谱组合，为缺少实测数据的指标提供仿真对照。","language":"zh","source_id":"P131","paper_slug":"2024-dynamic-extrema-prediction-and-reliability-assessment-of-vehicle-track-coupled-system","title":"车辆-轨道系统动力极值预测及可靠度计算","kind":"paper_usage"}],"word_links":[{"id":"W50e8b5140b2fd361499b16e7","name":"NTM","language":"en","kind":"variant","label":"同义表达","reason":null},{"id":"W66e3b900fc0c753d3994ac76","name":"Number theoretical method (NTM)","language":"en","kind":"variant","label":"名称变体","reason":null},{"id":"W9a2d66b7461d7b6014823bd4","name":"数论方法","language":"zh","kind":"translation","label":"参考译法","reason":null},{"id":"Wadaa8ce13b8198c7650f7faf","name":"numerical theory method","language":"en","kind":"variant","label":"原文变体","reason":null},{"id":"Wd7766aeacfa710d8bd625653","name":"Number Theory Method (NTM)","language":"en","kind":"variant","label":"名称变体","reason":null},{"id":"Wdb1eca119e63f7678fd99fe5","name":"数论法","language":"zh","kind":"translation","label":"参考译法","reason":null},{"id":"We003525c20a99bb059a579b5","name":"numerical theory method（NTM）","language":"en","kind":"variant","label":"名称变体","reason":null},{"id":"Wea652cd4d9b2c955929eea14","name":"Number Theory Method","language":"en","kind":"variant","label":"同义表达","reason":null},{"id":"W4db42de72f56349f12f41af4","name":"数论选点法","language":"zh","kind":"translation","label":"文献参考译法","reason":null}],"expression_links":[{"id":"W50e8b5140b2fd361499b16e7","name":"NTM","language":"en","kind":"variant","label":"同