tual reality","explanation":"营造具有现场感的实验环境，帮助学生认识结构与操作过程。","terms":[],"word_links":{"zh":{"id":"Wea1d85f0be52ed26e5ba5eef","group_id":"Wea1d85f0be52ed26e5ba5eef","zh":"虚拟现实","en":"","name":"虚拟现实","language":"zh","domain":"工程教育","domains":["工程教育","监测与数字化"],"abbreviations":[],"concept_id":null,"scope":"core","families":[]},"en":{"id":"Wea24f4283f63cb4ad334a7bc","group_id":"Wea24f4283f63cb4ad334a7bc","zh":"","en":"virtual reality","name":"virtual reality","language":"en","domain":"工程教育","domains":["工程教育","监测与数字化"],"abbreviations":[],"concept_id":null,"scope":"core","families":[]}}},{"zh":"人机交互","en":"Human-computer interaction","explanation":"学生通过鼠标、键盘等输入完成操作，并接收系统提示与反馈。","terms":[],"word_links":{"zh":{"id":"W5d83417c1c8959c397f23563","group_id":"W5d83417c1c8959c397f23563","zh":"人机交互","en":"","name":"人机交互","language":"zh","domain":"工程教育","domains":["工程教育"],"abbreviations":[],"concept_id":"Cc4b0fbc9f6713c5ae9b3","scope":"core","families":[]},"en":null}},{"zh":"面向服务的软件架构","en":"Service-oriented software architecture","explanation":"将实验指导、批改及教学管理等功能组织为服务的平台架构。","terms":[{"id":"C377e04d5f49b57aa25b1","zh":"面向服务的软件架构","en":"service-oriented software architecture","domain":"铁路动力学、信号与建模方法","group_id":"H90f172b1942b589e82f9","abbreviations":[]}],"word_links":{"zh":{"id":"W4048e73dc5a81f08656b6584","group_id":"W4048e73dc5a81f08656b6584","zh":"面向服务的软件架构","en":"","name":"面向服务的软件架构","language":"zh","domain":"铁路动力学、信号与建模方法","domains":["铁路动力学、信号与建模方法"],"abbreviations":[],"concept_id":"C377e04d5f49b57aa25b1","scope":"core","families":[]},"en":null}},{"zh":"有限元","en":"Finite element","explanation":"平台采用的结构分析技术之一，文中列出的相关软件为ANSYS。","terms":[],"word_links":{"zh":{"id":"W8c4d46a8f1933c65ee84977b","group_id":"W8c4d46a8f1933c65ee84977b","zh":"有限元","en":"","name":"有限元","language":"zh","domain":"文献术语","domains":[],"abbreviations":[],"concept_id":null,"scope":"context","families":[]},"en":null}},{"zh":"数据层","en":"Data layer","explanation":"存储和管理用户、设备、规则、流程及实验数据的平台层级。","terms":[],"word_links":{"zh":{"id":"Wcc1ab6332ef6d81ee3c8b32d","group_id":"Wcc1ab6332ef6d81ee3c8b32d","zh":"数据层","en":"","name":"数据层","language":"zh","domain":"文献术语","domains":[],"abbreviations":[],"concept_id":null,"scope":"context","families":[]},"en":null}},{"zh":"服务层","en":"Service layer","explanation":"统一管理实验记录、报告、考核与交流，并提供指导和批改功能。","terms":[],"word_links":{"zh":{"id":"Wd65c6f07386d2a84f35a1d6b","group_id":"Wd65c6f07386d2a84f35a1d6b","zh":"服务层","en":"","name":"服务层","language":"zh","domain":"文献术语","domains":[],"abbreviations":[],"concept_id":null,"scope":"context","families":[]},"en":null}},{"zh":"仿真层","en":"Simulation layer","explanation":"构建三维场景与虚拟实验环境，并支持交互式呈现。","terms":[],"word_links":{"zh":{"id":"W929b191e893b8803e1e51489","group_id":"W929b191e893b8803e1e51489","zh":"仿真层","en":"","name":"仿真层","language":"zh","domain":"文献术语","domains":[],"abbreviations":[],"concept_id":null,"scope":"context","families":[]},"en":null}},{"zh":"应用层","en":"Application layer","explanation":"面向教学实施与开放共享，组织实验任务和用户功能。","terms":[],"word_links":{"zh":{"id":"W36ac13bb73623c340c7a69ed","group_id":"W36ac13bb73623c340c7a69ed","zh":"应用层","en":"","name":"应用层","language":"zh","domain":"文献术语","domains":[],"abbreviations":[],"concept_id":null,"scope":"context","families":[]},"en":null}},{"zh":"加速度传感器","en":"Acceleration sensor","explanation":"元件设备库中的振动测试设备，供学生学习参数、原理及使用方法。","terms":[],"word_links":{"zh":{"id":"W31b4c1c4d6c3956e8bd7a293","group_id":"W31b4c1c4d6c3956e8bd7a293","zh":"加速度传感器","en":"","name":"加速度传感器","language":"zh","domain":"监测与数字化","domains":["监测与数字化"],"abbreviations":[],"concept_id":"C74cd1eb33fea808342de","scope":"core","families":[]},"en":null}},{"zh":"激振器","en":"Exciter","explanation":"用于施加振动激励的设备，属于学生需要认识和操作的仪器。","terms":[],"word_links":{"zh":{"id":"W59149179dfdf070e9745cec0","group_id":"W59149179dfdf070e9745cec0","zh":"激振器","en":"","name":"激振器","language":"zh","domain":"文献术语","domains":[],"abbreviations":[],"concept_id":null,"scope":"context","families":[]},"en":null}},{"zh":"落锤冲击实验","en":"Drop-hammer impact test","explanation":"实验教学要求掌握的冲击激励实验及其原理。","terms":[],"word_links":{"zh":{"id":"Wd21d502544a4e2c8ef170ca6","group_id":"Wd21d502544a4e2c8ef170ca6","zh":"落锤冲击实验","en":"","name":"落锤冲击实验","language":"zh","domain":"文献术语","domains":[],"abbreviations":[],"concept_id":null,"scope":"context","families":[]},"en":null}},{"zh":"轮轨力","en":"Wheel-rail force","explanation":"轮轨相互作用力，教学关注车辆、车速及轨道不平顺对其特征的影响。","terms":[],"word_links":{"zh":{"id":"W867cd114b99bed97398dbae3","group_id":"W867cd114b99bed97398dbae3","zh":"轮轨力","en":"","name":"轮轨力","language":"zh","domain":"动力响应","domains":["动力响应","车辆—轨道与基础结构动力学","车辆轨道基础结构动力学","车辆轨道随机动力学"],"abbreviations":[],"concept_id":null,"scope":"core","families":[]},"en":null}},{"zh":"轨道不平顺","en":"Track irregularity","explanation":"教学中考察的轨道条件之一，用于分析轮轨力与轨道振动的变化。","terms":[],"word_links":{"zh":{"id":"W0b390be60b54ddc4030f41a4","group_id":"W0b390be60b54ddc4030f41a4","zh":"轨道不平顺","en":"","name":"轨道不平顺","language":"zh","domain":"轨道几何","domains":["轨道几何"],"abbreviations":[],"concept_id":"Cd6d4ea1d7e05aa0361f7","scope":"core","families":[{"id":"geometry.irregularity","label":"轨道不平顺及其表征"}]},"en":null}},{"zh":"主动隔振","en":"Active vibration isolation","explanation":"论文所列理论实验模块的主题，文中未展开其具体控制装置或算法。","terms":[],"word_links":{"zh":{"id":"W172d42dca6d4c1443131a554","group_id":"W172d42dca6d4c1443131a554","zh":"主动隔振","en":"","name":"主动隔振","language":"zh","domain":"文献术语","domains":[],"abbreviations":[],"concept_id":null,"scope":"context","families":[]},"en":null}}],"related_terms":[{"id":"C377e04d5f49b57aa25b1","zh":"面向服务的软件架构","en":"service-oriented software architecture","domain":"铁路动力学、信号与建模方法","group_id":"H90f172b1942b589e82f9","abbreviations":[]},{"id":"C3dbd8e54de653e9ffcdc","zh":"铁道工程","en":"railway engineering","domain":"轨道隔振与工程教育","group_id":"Hfb6d3e494ddfe6411253","abbreviations":[]},{"id":"Cdc18ce614fac6e994a1f","zh":"人才培养","en":"talent training","domain":"轨道隔振与工程教育","group_id":"H2dfce2ac35dffa5eb45f","abbreviations":[]},{"id":"Cea75bfbc51ecf5759fef","zh":"钢弹簧浮置板轨道","en":"steel-spring floating-slab track","domain":"轨道隔振与工程教育","group_id":"H8afc0369959a34aebc8d","abbreviations":[]},{"id":"Cf43e3124f48d0bac5a67","zh":"虚拟仿真实验","en":"virtual simulation experiment","domain":"轨道隔振与工程教育","group_id":"Hb8e2403145d7106f3794","abbreviations":[]}]}