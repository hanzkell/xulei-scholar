{"id":"W41a551a9baab86e04c5b0cf1","zh":"余弦型不均匀沉降","en":"","name":"余弦型不均匀沉降","language":"zh","domain":"文献术语","concept_id":null,"families":[],"definition_zh":null,"definition_en":null,"scope_note":null,"usage_note":null,"usage_overview":null,"translation_note":null,"usage_variants":[],"designations":[{"id":"W41a551a9baab86e04c5b0cf1","text":"余弦型不均匀沉降","language":"zh","role":"headword"}],"complete_examples":[{"id":"Sdefdf8ffdd56d07c8044","source_id":"P136","page":1,"page_end":1,"language":"zh","text":"摘要:为探明弹性支承块式无砟轨道结构在基础变形恶劣地质条件下的变形规律,采用Abaqus有限元软件建立隧道段弹性支承块式无砟轨道精细化数值仿真模型,在考虑弹性支承块式无砟轨道道床板直接构筑于仰拱上的特殊结构形式前提下,以仰拱余弦型不均匀沉降作为基础变形输入形式,分析幅值、波长对钢轨位移、道床板位移及道床板与基础间离缝及脱空高度与长度的影响,提出基础变形作用下弹性支承块式无砟轨道的薄弱位置及最不利变形形式。","citations":[{"source_id":"P136","page":1,"page_end":1}]}],"sources":{"P136":{"id":"P136","title":"基础变形对弹性支承块式无砟轨道变形及离缝影响研究","authors":"曾志平,吴霁崟,王卫东,王继军,徐磊,李桩,刘卓","year":"2025","doi":"10.19713/j.cnki.43-1423/u.T20240581","journal_citation":"铁道科学与工程学报","label":"曾志平等（2025）","overview_slug":"2025-study-on-the-deformation-and-the-gap-of-low-vibration-track-under-the-influence-of-foundation-deform"}},"relations":[],"related_terms":[],"collocations":[],"symbols":[],"units":[],"formulas":[],"external_references":[],"suggested_comparisons":[],"contexts":[{"text":"用余弦下凹曲线描述沿线路纵向变化的基础沉降。","language":"zh","source_id":"P136","paper_slug":"2025-study-on-the-deformation-and-the-gap-of-low-vibration-track-under-the-influence-of-foundation-deform","title":"基础变形对弹性支承块式无砟轨道变形及离缝影响研究","kind":"paper_usage"}],"word_links":[{"id":"Wfce09f80f4bb52dad0231b8a","name":"Cosine-type inhomogeneous settlement","language":"en","kind":"translation","label":"文献参考译法","reason":null}],"expression_links":[{"id":"Wfce09f80f4bb52dad0231b8a","name":"Cosine-type inhomogeneous settlement","language":"en","kind":"translation","label":"文献参考译法","reason":null}],"same_language_synonyms":[],"cross_language_equivalents":[{"id":"Wfce09f80f4bb52dad0231b8a","name":"Cosine-type inhomogeneous settlement","language":"en","ki