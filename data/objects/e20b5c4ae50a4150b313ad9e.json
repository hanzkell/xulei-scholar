析。","terms":[],"word_links":{"zh":{"id":"W6c8461aa96781183d89d470c","group_id":"W6c8461aa96781183d89d470c","zh":"傅里叶频谱分析","en":"","name":"傅里叶频谱分析","language":"zh","domain":"文献术语","domains":[],"abbreviations":[],"concept_id":null,"scope":"context","families":[]},"en":null}},{"zh":"钢轨焊接接头","en":"rail welded joint","explanation":"沪宁算例中解释约100m周期振动能量峰的结构位置。","terms":[],"word_links":{"zh":{"id":"W734cf13cd3905f20d9b3d7a4","group_id":"W734cf13cd3905f20d9b3d7a4","zh":"钢轨焊接接头","en":"","name":"钢轨焊接接头","language":"zh","domain":"文献术语","domains":[],"abbreviations":[],"concept_id":null,"scope":"context","families":[]},"en":null}},{"zh":"钢轨接头伤损","en":"rail-joint damage","explanation":"朔黄算例中对25m周期轴箱能量峰给出的原因解释。","terms":[],"word_links":{"zh":{"id":"Wf2e2c15249086aaa175a8a44","group_id":"Wf2e2c15249086aaa175a8a44","zh":"钢轨接头伤损","en":"","name":"钢轨接头伤损","language":"zh","domain":"文献术语","domains":[],"abbreviations":[],"concept_id":null,"scope":"context","families":[]},"en":null}},{"zh":"空间定位","en":"spatial localization","explanation":"根据能量突变在沿线坐标上的位置缩小病害检查范围。","terms":[],"word_links":{"zh":{"id":"Wef5599bb460df5d5e7a6e582","group_id":"Wef5599bb460df5d5e7a6e582","zh":"空间定位","en":"","name":"空间定位","language":"zh","domain":"文献术语","domains":[],"abbreviations":[],"concept_id":null,"scope":"context","families":[]},"en":null}},{"zh":"二系悬挂","en":"secondary suspension","explanation":"将轮轨激扰传递至车体时产生缓冲与能量衰减的连接系统。","terms":[],"word_links":{"zh":{"id":"Wcb35817324f3a727c01c9eb0","group_id":"Wcb35817324f3a727c01c9eb0","zh":"二系悬挂","en":"","name":"二系悬挂","language":"zh","domain":"铁路动力学与方法","domains":["铁路动力学与方法"],"abbreviations":[],"concept_id":"C056e48a66c2bfcc935c4","scope":"core","families":[]},"en":null}}],"related_terms":[{"id":"C06e702c355a348cd6792","zh":"连续小波变换","en":"continuous wavelet transform","domain":"轨道不平顺与信号处理","group_id":"H2ff749aadd9fcfe7dad4","abbreviations":[]},{"id":"C6191468cc8350c05b95d","zh":"时间-尺度","en":"time-scale","domain":"轨道不平顺与信号处理","group_id":"H380c02e1e0c95ca1d4d8","abbreviations":[]},{"id":"C97c8dc0588c36420f091","zh":"小波能量谱","en":"wavelet energy spectrum","domain":"轨道不平顺与信号处理","group_id":"Hb7fde995bc1510f9d435","abbreviations":[]},{"id":"Cb1dacd83f64bb4e5a7f2","zh":"能量谱","en":"energy spectrum","domain":"轨道不平顺与信号处理","group_id":"H145fe5dbdf7760c14561","abbreviations":[]},{"id":"Cd6d4ea1d7e05aa0361f7","zh":"轨道不平顺","en":"track irregularity","domain":"轨道几何","group_id":"H2ed83333df288adf5282","abbreviations":[]},{"id":"Ce47cd92d48bab223e920","zh":"轨道病害","en":"track disease","domain":"轨道不平顺与信号处理","group_id":"H548d7ebb5aec542f638d","abbreviations":[]},{"id":"Cfbd28143ec92a4daca0a","zh":"轴箱加速度","en":"axle-box acceleration","domain":"轨道不平顺与信号处理","group_id":"Hbf37dcb0b836f1c79074","abbreviations":[]},{"id":"Cfdb87c66d7ab89352d5a","zh":"容许条件","en":"Admission Condition","domain":"铁路动力学、信号与建模方法","group_id":"He8b570759baa6bc7799a","abbreviations":[]}]}